# PHP 8.3 with pdo_mysql for the Laravel fixture app. The extension is
# built from the PHP source the image ships, so nothing is downloaded.
FROM php:8.3-cli@sha256:98d555ff97b3865140ad31032508c3ca089fa97a8944b14ca9dc03ea05d788cd
RUN docker-php-ext-install pdo_mysql
