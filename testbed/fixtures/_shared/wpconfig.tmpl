database the scenario runs against when it puts the file in place, so no
password is ever in a fixture. */ -}}

{{- define "wpconfig_db" -}}
<?php
/**
 * The base configuration for WordPress (production).
 */
define( 'DB_NAME', '@@DB_NAME@@' );
define( 'DB_USER', '@@DB_USER@@' );
define( 'DB_PASSWORD', '@@DB_PASSWORD@@' );
define( 'DB_HOST', '@@DB_HOST@@' );
define( 'DB_CHARSET', 'utf8mb4' );
define( 'DB_COLLATE', '' );
