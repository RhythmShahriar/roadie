{{- define "usermeta" -}}
{{- $p := .p}}{{$tag := .tag}}{{$base := .base}}{{$meta := .meta -}}
INSERT INTO `{{$p}}usermeta` VALUES {{range $i := seq .n}}{{$n := printf "%s%d" $tag $i}}{{$m := add $meta (mul $i 5)}}{{if gt $i 1}},{{end}}({{$m}},{{add $base $i}},'first_name','{{sql (canary "first_name" $n (printf "%susermeta.meta_value" $p))}}'),({{add $m 1}},{{add $base $i}},'last_name','{{sql (canary "last_name" $n (printf "%susermeta.meta_value" $p))}}'),({{add $m 2}},{{add $base $i}},'billing_phone','{{sql (canary "phone" $n (printf "%susermeta.meta_value" $p))}}'),({{add $m 3}},{{add $base $i}},'billing_address_1','{{sql (canary "street" $n (printf "%susermeta.meta_value" $p))}}'),({{add $m 4}},{{add $base $i}},'billing_email','{{sql (canary "email" $n)}}'){{end}};
{{end -}}

{{- /* The live Stripe gateway settings: serialized, testmode no, live keys
assembled at seed time. */ -}}
{{- define "stripe_live" -}}
{{sarr "enabled" "s:3:\"yes\";" "title" "s:11:\"Credit Card\";" "testmode" "s:2:\"no\";" "publishable_key" (ser (key "stripe_live_publishable")) "secret_key" (ser (key "stripe_live_secret")) "webhook_secret" (ser (key "stripe_webhook_secret")) "test_publishable_key" (ser (key "stripe_test_publishable")) "test_secret_key" (ser (key "stripe_test_secret"))}}
{{- end -}}

{{- /* One multisite blog's tables: dict "p" prefix "url" home URL "tag"
canary prefix "n" customers "woo" bool. Users live in the network
tables; a blog holds options, posts with comments and, with woo, orders. */ -}}
{{- define "blog" -}}
{{- $p := .p}}{{$tag := .tag}}{{$url := .url -}}
{{template "wp_options" $p}}
LOCK TABLES `{{$p}}options` WRITE;
INSERT INTO `{{$p}}options` VALUES (1,'siteurl','{{$url}}','on'),(2,'home','{{$url}}','on'),(3,'blogname','Bean & Leaf {{$tag}}','on'),(4,'blog_public','1','on'),(5,'admin_email','{{sql (canary "email" (printf "%sadmin" $tag) (printf "%soptions.option_value" $p))}}','on');
UNLOCK TABLES;
{{template "wp_comments" $p}}
LOCK TABLES `{{$p}}comments` WRITE;
INSERT INTO `{{$p}}comments` VALUES {{range $i := seq .n}}{{$k := printf "%s%d" $tag $i}}{{if gt $i 1}},{{end}}({{$i}},1,'{{sql (canary "full_name" $k (printf "%scomments.comment_author" $p))}}','{{sql (canary "email" $k (printf "%scomments.comment_author_email" $p))}}','{{sql (canary "ip" $k (printf "%scomments.comment_author_IP" $p))}}','2026-05-01 10:00:00','{{sql "Lovely beans, see my blog " $url "/?p=1 and call " (canary "phone" $k (printf "%scomments.comment_content" $p))}}','1','comment',0){{end}};
UNLOCK TABLES;
{{- if .woo}}
{{template "wp_wc_orders" $p}}
LOCK TABLES `{{$p}}wc_orders` WRITE;
INSERT INTO `{{$p}}wc_orders` VALUES {{range $i := seq .n}}{{$k := printf "%s%d" $tag $i}}{{if gt $i 1}},{{end}}({{add $i 100}},'wc-completed','EUR','shop_order',30.00000000,0,'{{sql (canary "email" $k)}}','2026-05-02 10:00:00',0,'cod','','{{sql (canary "ip" $k)}}','',''){{end}};
UNLOCK TABLES;
{{template "wp_wc_order_addresses" $p}}
LOCK TABLES `{{$p}}wc_order_addresses` WRITE;
INSERT INTO `{{$p}}wc_order_addresses` VALUES {{range $i := seq .n}}{{$k := printf "%s%d" $tag $i}}{{if gt $i 1}},{{end}}({{$i}},{{add $i 100}},'billing','{{sql (canary "first_name" $k (printf "%swc_order_addresses.first_name" $p))}}','{{sql (canary "last_name" $k (printf "%swc_order_addresses.last_name" $p))}}','{{sql (canary "street" $k (printf "%swc_order_addresses.address_1" $p))}}','Lyon','69001','FR','{{sql (canary "email" $k)}}','{{sql (canary "phone" $k)}}'){{end}};
UNLOCK TABLES;
{{- end}}
{{end -}}

{{- /* r18's rows, for every format: "ext" true writes extended INSERTs. */ -}}
{{- define "r18_users" -}}
{{- if .ext -}}
INSERT INTO `wp_users` VALUES {{range $i := seq 40}}{{$n := printf "f%d" $i}}{{if gt $i 1}},{{end}}({{$i}},'f{{$i}}','$wp$2y$10$testbedtestbedtestbedtestbedtestbedtestbedtestbedtes','f-{{$i}}','{{sql (canary "email" $n "wp_users.user_email")}}','','2026-06-02 10:00:00','',0,'{{sql (canary "full_name" $n "wp_users.display_name")}}'){{end}};
{{else -}}
{{range $i := seq 40}}{{$n := printf "f%d" $i}}INSERT INTO `wp_users` VALUES ({{$i}},'f{{$i}}','$wp$2y$10$testbedtestbedtestbedtestbedtestbedtestbedtestbedtes','f-{{$i}}','{{sql (canary "email" $n "wp_users.user_email")}}','','2026-06-02 10:00:00','',0,'{{sql (canary "full_name" $n "wp_users.display_name")}}');
{{end -}}
{{end -}}
{{end -}}

