{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "rhythm-roadie",
          "version": "1.0.0",
          "informationUri": "https://github.com/RhythmShahriar/roadie",
          "rules": [
            {
              "id": "config.environment",
              "shortDescription": {
                "text": "WP_ENVIRONMENT_TYPE is unset"
              },
              "helpUri": "https://github.com/RhythmShahriar/rhythm/wiki/Roadie-Verify-And-Reports#config.environment",
              "properties": {
                "security-severity": "5.0"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "key.stripe-live",
              "shortDescription": {
                "text": "Stripe live key"
              },
              "helpUri": "https://github.com/RhythmShahriar/rhythm/wiki/Roadie-Verify-And-Reports#key.stripe-live",
              "properties": {
                "security-severity": "9.5"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "pii.email",
              "shortDescription": {
                "text": "real-looking emails"
              },
              "helpUri": "https://github.com/RhythmShahriar/rhythm/wiki/Roadie-Verify-And-Reports#pii.email",
              "properties": {
                "security-severity": "8.0"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "toolExecutionNotifications": [
            {
              "level": "note",
              "message": {
                "text": "skipped wp_wc_admin_notes: a table Roadie was told to keep"
              }
            }
          ]
        }
      ],
      "results": [
        {
          "ruleId": "pii.email",
          "level": "error",
          "message": {
            "text": "3 real-looking emails: wp_users 42 (e.g. ad•••@gm•••.com). Fix: rhythm-roadie prepare staging.sql.gz"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "staging.sql.gz"
                }
              },
              "logicalLocations": [
                {
                  "name": "user_email",
                  "fullyQualifiedName": "wp_users.user_email",
                  "kind": "member"
                }
              ]
            }
          ],
          "partialFingerprints": {
            "roadieFinding/v1": "9104e1118a5571ca"
          },
          "properties": {
            "count": 2,
            "severity": "high"
          }
        },
        {
          "ruleId": "pii.email",
          "level": "error",
          "message": {
            "text": "3 real-looking emails: wp_postmeta _billing_email (e.g. ad•••@gm•••.com). Fix: rhythm-roadie prepare staging.sql.gz"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "staging.sql.gz"
                }
              },
              "logicalLocations": [
                {
                  "name": "meta_value",
                  "fullyQualifiedName": "wp_postmeta.meta_value",
                  "kind": "member"
                }
              ]
            }
          ],
          "partialFingerprints": {
            "roadieFinding/v1": "cbee6b404c9e54d6"
          },
          "properties": {
            "count": 1,
            "severity": "high"
          }
        },
        {
          "ruleId": "key.stripe-live",
          "level": "error",
          "message": {
            "text": "Stripe live key: wp_options woocommerce_stripe_settings → serialized:secret_key (e.g. sk_l•••••)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "staging.sql.gz"
                }
              },
              "logicalLocations": [
                {
                  "name": "option_value",
                  "fullyQualifiedName": "wp_options.option_value",
                  "kind": "member"
                }
              ]
            }
          ],
          "partialFingerprints": {
            "roadieFinding/v1": "bc934ace9c3d8b35"
          },
          "properties": {
            "count": 1,
            "severity": "critical"
          }
        },
        {
          "ruleId": "config.environment",
          "level": "warning",
          "message": {
            "text": "WP_ENVIRONMENT_TYPE is unset: wp-config.php line 41"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "wp-config.php"
                },
                "region": {
                  "startLine": 41
                }
              }
            }
          ],
          "partialFingerprints": {
            "roadieFinding/v1": "d45ac131f97a1707"
          },
          "properties": {
            "count": 1,
            "severity": "medium"
          }
        }
      ],
      "properties": {
        "not_covered": "Not covered by this report: files and uploads (PDF invoices, form uploads, images with location data), other databases, object caches (Redis, Memcached), search indexes (Algolia, ElasticPress), logs on disk outside wp-content, copies held by third parties (Mailchimp lists, Stripe customers), names and street addresses written in free text that Roadie didn't see in a structured column, encrypted columns, tables you told Roadie to keep, uploads on the staging host.",
        "notice": "Pseudonymised data is still personal data under the GDPR (Article 4(5), Recital 26). This report shows what Roadie's checks found in this copy; it is not a statement that the copy holds no personal data. Signed by roadie:NHUPmL1… (rhythm-roadie report check report.json): the signature shows who ran Roadie, which version and rules, on which input and that the report is unchanged since. It doesn't prove the data holds no personal data.",
        "result": "fail",
        "verdict": "findings",
        "verify_mode": "heuristic"
      }
    }
  ]
}
