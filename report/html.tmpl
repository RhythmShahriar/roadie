<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; img-src data:">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="no-referrer">
<meta name="robots" content="noindex, nofollow">
<title>{{.Title}}</title>
<style>
:root{--ink:#100F0D;--paper:#FFFFFF;--muted:#6B7280;--line:#E5E7EB;--card:#F9FAFB;--dot:#FF7C52;--ok:#10B981;--bad:#EF4444;--high:#F97316;--warn:#EAB308;--low:#60A5FA}
@media (prefers-color-scheme:dark){:root{--ink:#F3F4F6;--paper:#100F0D;--muted:#9CA3AF;--line:#2A2926;--card:#1A1916}}
*{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--ink);font:15px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif}
main{max-width:980px;margin:0 auto;padding:24px 16px 48px}
header.top{display:flex;align-items:center;gap:12px;margin-bottom:16px}
header.top img{max-height:40px;max-width:160px}
header.top .brand{font-weight:600}
header.top .tool{color:var(--muted);margin-left:auto}
h2{font-size:17px;margin:28px 0 10px;border-bottom:1px solid var(--line);padding-bottom:4px}
h3{font-size:15px;margin:16px 0 6px}
.band{border-radius:10px;padding:16px 20px;border:2px solid var(--muted);margin:8px 0 16px}
.band.pass{border-color:var(--ok)}.band.fail,.band.stop{border-color:var(--bad)}.band.plan,.band.done{border-color:var(--warn)}
.band .word{font-weight:700;font-size:20px;margin-right:10px}
.band.pass .word{color:var(--ok)}.band.fail .word,.band.stop .word{color:var(--bad)}.band.plan .word,.band.done .word{color:var(--warn)}
.band .line{font-size:18px}
.band .meta{color:var(--muted);margin-top:4px;font-size:13px}
.error{background:var(--card);border-left:4px solid var(--bad);padding:10px 14px;margin:12px 0}
dl.card{display:grid;grid-template-columns:max-content 1fr;gap:4px 16px;background:var(--card);border-radius:10px;padding:14px 18px;margin:0}
dl.card dt{color:var(--muted)}dl.card dd{margin:0;overflow-wrap:anywhere}
table{border-collapse:collapse;width:100%;font-size:14px}
th,td{text-align:left;padding:6px 8px;border-bottom:1px solid var(--line);vertical-align:top;overflow-wrap:anywhere}
th{color:var(--muted);font-weight:600}
code{font:13px/1.4 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;background:var(--card);padding:1px 4px;border-radius:4px;overflow-wrap:anywhere}
.ok{color:var(--ok)}.bad{color:var(--bad)}.muted{color:var(--muted)}.warn{color:var(--warn)}
.finding{border-left:4px solid var(--muted);padding:6px 12px;margin:8px 0;background:var(--card);border-radius:0 8px 8px 0}
.finding.critical{border-color:var(--bad)}.finding.high{border-color:var(--high)}.finding.medium{border-color:var(--warn)}.finding.low{border-color:var(--low)}
.badge{display:inline-block;font-size:11px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;padding:1px 6px;border-radius:4px;border:1px solid currentColor;margin-right:6px}
.badge.critical{color:var(--bad)}.badge.high{color:var(--high)}.badge.medium{color:var(--warn)}.badge.low{color:var(--low)}.badge.info{color:var(--muted)}
.finding .sub{color:var(--muted);font-size:13px}
.note{color:var(--muted);font-size:13px}
.notcovered{background:var(--card);border-radius:10px;padding:12px 16px}
footer{margin-top:24px;border-top:1px solid var(--line);padding-top:12px;font-size:13px}
footer p{margin:0}
footer .sig{margin-top:10px;color:var(--muted)}
section.report+section.report{margin-top:48px;border-top:3px solid var(--line);padding-top:8px}
</style>
</head>
<body>
<main>
<header class="top">{{if .Logo}}<img src="{{.Logo}}" alt="">{{end}}{{if .Brand}}<span class="brand">{{.Brand}}</span>{{end}}<span class="tool">rhythm roadie</span></header>
{{if .Many}}
<h2>Summary, worst first</h2>
<table>
<tr><th>Result</th><th>Copy</th><th>Findings</th><th>Run</th><th>Started</th></tr>
{{range .Reports}}<tr><td><a href="#{{.Anchor}}" class="{{if eq .Class "pass"}}ok{{else}}bad{{end}}">{{.Word}}</a></td><td>{{.Target}}</td><td>{{.Counts}}</td><td>{{.Kind}}</td><td>{{.Started}}</td></tr>
{{end}}</table>
{{end}}
{{range .Reports}}
<section class="report" id="{{.Anchor}}">
<div class="band {{.Class}}"><span class="word">{{.Word}}</span><span class="line">{{.Line}}</span>
<div class="meta">{{.Counts}}{{if .Started}} · {{.Started}}{{end}}{{if .KeyShort}} · signed by {{.KeyShort}}{{else}} · not signed{{end}}</div></div>
{{if .Error}}<div class="error">{{.Error}}<br><span class="note">rhythm-roadie explain says more about the code.</span></div>{{end}}

<h2>Copy</h2>
<dl class="card">{{range .Card}}<dt>{{.Key}}</dt><dd>{{.Value}}</dd>{{end}}</dl>

{{if .Checks}}<h2>Checks</h2>
<table><tr><th>Check</th><th>Result</th><th>ID</th></tr>
{{range .Checks}}<tr><td>{{.Label}}</td><td class="{{if eq .Status "pass"}}ok{{else if eq .Status "fail"}}bad{{else if eq .Status "warn"}}warn{{else}}muted{{end}}">{{if eq .Status "pass"}}&#10003;{{else if eq .Status "fail"}}&#10007;{{else if eq .Status "warn"}}!{{else}}&#183;{{end}} {{.Result}}</td><td><code>{{.ID}}</code></td></tr>
{{end}}</table>{{end}}

{{if .FindingsAny}}<h2>Findings</h2>
{{range .Groups}}{{$sev := .Severity}}{{range .Findings}}<div class="finding {{$sev}}"><span class="badge {{$sev}}">{{$sev}}</span><strong>{{.Title}}</strong>
{{if .Where}}<div class="sub">{{.Where}}</div>{{end}}{{if .Examples}}<div class="sub">e.g. <code>{{.Examples}}</code></div>{{end}}{{if .Detail}}<div class="sub">{{.Detail}}</div>{{end}}{{if .Fix}}<div>Fix: <code>{{.Fix}}</code></div>{{end}}
<div class="sub">More: <code>rhythm-roadie explain {{.ID}}</code></div></div>
{{end}}{{end}}{{range .Uncovered}}<div class="finding high"><span class="badge high">uncovered</span>{{.}}<div class="sub">Add it under columns: in .roadie/config.yaml. More: <code>rhythm-roadie explain uncovered-column</code></div></div>
{{end}}{{end}}

{{if .Tables}}<h2>What changed</h2>
<table><tr><th>Table</th><th>Rows</th><th>Action</th><th>Profile</th><th>Columns</th></tr>
{{range .Tables}}<tr><td><code>{{.Name}}</code></td><td>{{.Rows}}</td><td>{{.Action}}</td><td>{{.Profile}}</td><td>{{.What}}</td></tr>
{{end}}</table>{{end}}

{{if .Keys}}<h2>Keys</h2>
<table><tr><th>Provider</th><th>Where</th><th>Value</th><th>Action</th></tr>
{{range .Keys}}<tr><td><span class="badge {{.Severity}}">{{.Severity}}</span>{{.Provider}} {{.Env}}</td><td>{{.Where}}</td><td><code>{{.Masked}}</code></td><td>{{.Action}}</td></tr>
{{end}}</table>{{end}}

{{if .Effects}}<h2>Side effects</h2>
<table><tr><th>Side effect</th><th>Status</th><th>How</th><th>To turn it back on for a test</th></tr>
{{range .Effects}}<tr><td>{{.Label}}</td><td class="{{.Class}}">{{.Status}}</td><td>{{.How}}</td><td>{{if .Undo}}<code>{{.Undo}}</code>{{end}}</td></tr>
{{end}}</table>
<p class="note">Not stopped: {{.NotStopped}}</p>{{end}}

<h2>Not covered</h2>
<p class="notcovered">{{.NotCovered}}</p>

<footer>
{{range .Footer}}<p>{{.}}</p>
{{end}}<div class="sig">Roadie {{.Version}} · profile pack {{.Pack}}{{with .Signature}}<br>Signature: {{.Alg}}, key {{.KeyID}}, public key <code>{{.PublicKey}}</code>{{end}}<br>{{.ViewNote}}</div>
</footer>
</section>
{{end}}
</main>
</body>
</html>
